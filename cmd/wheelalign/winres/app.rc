// Ресурсы Windows: значок, манифест (поддержка высокого DPI) и сведения о
// версии. Собирается в ../rsrc_windows_amd64.syso — см. README.md рядом.

1 ICON "icon.ico"
1 24 "app.manifest"

1 VERSIONINFO
FILEVERSION     2,0,0,0
PRODUCTVERSION  2,0,0,0
FILEOS          0x40004
FILETYPE        0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "041904B0"
    BEGIN
      VALUE "CompanyName",      "Открытый проект"
      VALUE "FileDescription",  "Сход-развал — открытый стенд"
      VALUE "FileVersion",      "2.0.0"
      VALUE "InternalName",     "wheelalign"
      VALUE "LegalCopyright",   "AGPL-3.0"
      VALUE "OriginalFilename", "wheelalign.exe"
      VALUE "ProductName",      "Сход-развал"
      VALUE "ProductVersion",   "2.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x419, 1200
  END
END
